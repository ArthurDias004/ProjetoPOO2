@model academico.Models.Projeto

@{
    ViewData["Title"] = "Excluir Projeto";
}

<h1>@ViewData["Title"]</h1>

<h3>Confirma exclusão deste projeto?</h3>

<div>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">Sigla</dt>
        <dd class="col-sm-10">@Model.Sigla</dd>

        <dt class="col-sm-2">Ano</dt>
        <dd class="col-sm-10">@Model.Ano</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.Ativo ? "Ativo" : "Inativo")</dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProjetoId" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Cancelar</a>
    </form>
</div>